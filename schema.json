{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tman9590/Yard-Critters/v1.0.2/schema.json",
  "title": "Yard Critters universal manifest",
  "type": "object",
  "required": ["name", "version", "input", "labels", "backends"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "input": {"type": "object"},
    "labels": {"type": "string"},
    "backends": {
      "type": "object",
      "required": ["coreml", "openvino", "onnx", "ncnn"]
    },
    "upstream": {"type": "object"}
  },
  "additionalProperties": true
}
